import os
import yt_dlp

def download_youtube_video(url, save_path):
    """Download a YouTube video to the given directory.

    Parameters
    ----------
    url : str
        Direct link to the YouTube video to download.
    save_path : str
        Destination directory for the downloaded file. The folder is
        created if it does not already exist.

    The function uses ``yt_dlp`` to fetch the best quality video and saves
    it in ``save_path`` with the video's title as the filename.
    """
    try:
        os.makedirs(save_path, exist_ok=True)
        ydl_opts = {
            'outtmpl': save_path + '/%(title)s.%(ext)s',
            'format': 'best'
        }
        with yt_dlp.YoutubeDL(ydl_opts) as ydl:
            ydl.download([url])
        print("Download completed!")
    except Exception as e:
        print(f"An error occurred: {e}")

if __name__ == "__main__":
    video_url = " "  # inside the" "Replace with your video URL
    download_path = " "  # inside the" "Replace with your path
    download_youtube_video(video_url, download_path)
